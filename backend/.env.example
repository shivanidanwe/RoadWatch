# RoadWatch Phase 2 Environment Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (Defaults to local SQLite if not configured)
DATABASE_URL=sqlite:///./roadwatch.db
# For PostgreSQL / PostGIS in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/roadwatch_db

# Machine Learning Artifacts
MODEL_VERSION=v2.4-RandomForest-Ensemble
MODEL_ARTIFACTS_DIR=./backend/artifacts
DATA_DIR=./backend/data

# API Security (optional tokens for production deployment)
API_SECRET_KEY=roadwatch-phase2-secure-random-token-2024
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

